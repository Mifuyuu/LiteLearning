FROM php:8.4-fpm-alpine

RUN apk add --no-cache \
    git curl libpng-dev oniguruma-dev libxml2-dev libzip-dev icu-dev unzip nodejs npm \
    freetype-dev libjpeg-turbo-dev libwebp-dev \
    linux-headers $PHPIZE_DEPS \
    && pecl install xdebug \
    && docker-php-ext-enable xdebug

# MySQL/MariaDB + common ext
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install intl pdo pdo_mysql zip mbstring exif pcntl bcmath gd

# Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# PHP-FPM config สำหรับ dev
RUN echo "memory_limit = 256M" >> /usr/local/etc/php/conf.d/docker.ini
RUN echo "max_execution_time = 120" >> /usr/local/etc/php/conf.d/docker.ini
RUN echo "upload_max_filesize = 50M" >> /usr/local/etc/php/conf.d/docker.ini
RUN echo "post_max_size = 55M" >> /usr/local/etc/php/conf.d/docker.ini
RUN echo "xdebug.mode = debug" >> /usr/local/etc/php/conf.d/docker.ini
RUN echo "xdebug.start_with_request = trigger" >> /usr/local/etc/php/conf.d/docker.ini
RUN echo "xdebug.client_host = host.docker.internal" >> /usr/local/etc/php/conf.d/docker.ini
RUN echo "xdebug.client_port = 9003" >> /usr/local/etc/php/conf.d/docker.ini

# PHP performance tuning (ไม่ต้อง compile ใหม่ทุก 2 วิ)
RUN echo "opcache.revalidate_freq = 60" >> /usr/local/etc/php/conf.d/docker.ini
RUN echo "opcache.validate_timestamps = 1" >> /usr/local/etc/php/conf.d/docker.ini
RUN echo "realpath_cache_size = 4096k" >> /usr/local/etc/php/conf.d/docker.ini
RUN echo "realpath_cache_ttl = 600" >> /usr/local/etc/php/conf.d/docker.ini

# ยก max_children ถ้า CPU มีพอ
RUN echo "pm.max_children = 10" >> /usr/local/etc/php-fpm.d/www.conf
RUN echo "pm.start_servers = 4" >> /usr/local/etc/php-fpm.d/www.conf
RUN echo "pm.min_spare_servers = 2" >> /usr/local/etc/php-fpm.d/www.conf
RUN echo "pm.max_spare_servers = 6" >> /usr/local/etc/php-fpm.d/www.conf

# --- Build stage: composer deps + frontend assets ---
FROM php:8.4-cli-alpine AS build
RUN apk add --no-cache git unzip nodejs npm
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html

COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-scripts --no-progress

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build && composer dump-autoload --optimize --no-dev

# --- Runtime stage ---
FROM php:8.4-fpm-alpine

RUN apk add --no-cache --virtual .build-deps $PHPIZE_DEPS libpng-dev oniguruma-dev libxml2-dev libzip-dev icu-dev freetype-dev libjpeg-turbo-dev libwebp-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install pdo pdo_mysql intl zip mbstring exif pcntl bcmath opcache gd \
    && apk del .build-deps \
    && apk add --no-cache libpng icu-libs libzip libxml2 freetype libjpeg-turbo libwebp

WORKDIR /var/www/html
COPY --from=build /var/www/html /var/www/html

RUN echo "memory_limit = 256M" >> /usr/local/etc/php/conf.d/docker.ini \
    && echo "max_execution_time = 120" >> /usr/local/etc/php/conf.d/docker.ini \
    && echo "upload_max_filesize = 50M" >> /usr/local/etc/php/conf.d/docker.ini \
    && echo "post_max_size = 55M" >> /usr/local/etc/php/conf.d/docker.ini \
    && echo "opcache.revalidate_freq = 60" >> /usr/local/etc/php/conf.d/docker.ini \
    && echo "opcache.validate_timestamps = 0" >> /usr/local/etc/php/conf.d/docker.ini \
    && echo "opcache.memory_consumption = 96" >> /usr/local/etc/php/conf.d/docker.ini \
    && echo "realpath_cache_size = 4096k" >> /usr/local/etc/php/conf.d/docker.ini \
    && echo "realpath_cache_ttl = 600" >> /usr/local/etc/php/conf.d/docker.ini

# pm tuning for a 1-2GB RAM host — keep worker count low
RUN echo "pm.max_children = 4" >> /usr/local/etc/php-fpm.d/www.conf \
    && echo "pm.start_servers = 2" >> /usr/local/etc/php-fpm.d/www.conf \
    && echo "pm.min_spare_servers = 1" >> /usr/local/etc/php-fpm.d/www.conf \
    && echo "pm.max_spare_servers = 3" >> /usr/local/etc/php-fpm.d/www.conf

RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

EXPOSE 9000
